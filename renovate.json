{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "ignoreDeps": ["github.com/xJohnNascimento/corridor"],
  "postUpdateOptions": ["gomodTidy"],
  "rebaseWhen": "behind-base-branch",
  "labels": ["release: patch"],
  "packageRules": [
    {
      "description": "Updates that only touch the workflows or the Terraform lint release nothing",
      "matchManagers": ["github-actions", "tflint-plugin"],
      "labels": ["release: none"]
    },
    {
      "description": "Code generators and linters run through go tool never reach the image, so their updates release nothing",
      "matchPackageNames": ["github.com/bufbuild/buf", "go.temporal.io/sdk/contrib/tools/workflowcheck"],
      "labels": ["release: none"]
    },
    {
      "description": "A ledger release moves the API module and the compose image together",
      "matchPackageNames": ["github.com/xJohnNascimento/ledger/api", "ghcr.io/xjohnnascimento/ledger"],
      "groupName": "ledger"
    },
    {
      "description": "PostgreSQL moves a major version by hand, together with the test containers and Aurora",
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
